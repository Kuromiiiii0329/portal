# Local runtime cache (regenerated when the app runs).
# Kept in the v1.0 snapshot on purpose; uncomment to ignore it going forward.
# data/

# Scratch space for the upgrade analysis (extracted third-party report text, probes).
.upgrade_analysis/

# Virtual trading: derived feature snapshots are regenerable and grow daily.
# Decision records (rules.jsonl / anchors.json / plans / fills / ledger) ARE committed
# on purpose — they are the audit trail.
data/virtual/features/
data/virtual/reports/

# Backtest market database: rebuildable from the network and measured in hundreds of MB.
# Never commit it. Rebuild with: python -m portal.virtual.marketdb build
data/market.db
data/market.db-wal
data/market.db-shm
data/multi_*.db
